# --- Summary provider A: any OpenAI-compatible router
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5.6-luna

# --- Summary provider B: Gemini via Google AI Studio, directly
# Any model id starting with "gemini" is routed here, with this key.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# --- Google Sheets (service account, shared with the sheet as Editor)
GOOGLE_SA_JSON=service_account.json
SHEET_ID=
